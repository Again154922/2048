# ============================================================
#  Unity（2048Unity v1.0/）
# ============================================================

# 编辑器生成的缓存目录：体积巨大（这个项目 1.5 GB），永远不要提交
[Ll]ibrary/
[Tt]emp/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Bb]uild/
[Bb]uilds/

# Unity 自动生成的工程文件：编辑器会按当前环境重建，提交了只会产生噪音
*.sln
*.csproj
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.mdb
*.opendb
*.VC.db

# Unity 崩溃/诊断
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta

# BUT：控制台项目的解决方案和工程文件要保留
!2048Console/2048Console.sln
!2048Console/**/*.csproj

# ============================================================
#  .NET / C#（2048Console/）
# ============================================================

[Bb]in/
[Oo]bj/
*.pdb

# ============================================================
#  IDE / 编辑器
# ============================================================

.idea/
.vs/
**/.obsidian/
*.DotSettings.user
*.sln.DotSettings.user
/_ReSharper.Caches/
riderModule.iml

# ============================================================
#  系统文件
# ============================================================

Thumbs.db
Desktop.ini
.DS_Store

# ============================================================
#  本地临时
# ============================================================

*.tmp
*.log
